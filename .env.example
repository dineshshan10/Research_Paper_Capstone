# Copy to .env and fill in the keys you have. All are optional.
#
# Nothing here is required for ingestion, local embeddings, retrieval, or the
# benchmark harness -- those run fully offline. Keys only unlock:
#   GEMINI_API_KEY  -> answer generation + LLM-judged evaluation metrics
#   OPENAI_API_KEY  -> the commercial arm of the embedding bake-off (C3), ~$0.02
#   TAVILY_API_KEY  -> corrective RAG web-search fallback (stretch goal S3)

GEMINI_API_KEY=
OPENAI_API_KEY=
TAVILY_API_KEY=
